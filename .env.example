# ============================================================
# Blood on the Clock - Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- MySQL (SQL database) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=emergency_system

# ---- MongoDB (NoSQL database) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=emergency_system

# ---- Auth ----
# A long random string used to sign session JWTs (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret-string-of-at-least-32-chars
